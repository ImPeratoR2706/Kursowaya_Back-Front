POSTGRES_DB=hair_salon_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Локально без PostgreSQL: раскомментируйте следующую строку (файл Backend/db.sqlite3)
# USE_SQLITE=1

# Метрики «Запустить»: 1 = демо-ACC, 0 = по вероятностям модели (см. также AI_ALIGN_BEFORE_METRICS)
# AI_STAGED_RUN_METRICS=0

# Перед метриками: align в Aidata + случайная «нечестная» accuracy 79–95% (курсовой режим). 0 = честный CatBoost
# AI_ALIGN_BEFORE_METRICS=1
